---
import MainLayout from "../layout/main-layout.astro";
---

<MainLayout title="Tonie | 404" description="Page not found">
	<section class="not-found-section">
		<h1>404</h1>
		<p>uhm... this page doesn't exist</p>
	</section>
</MainLayout>

<style>
	.not-found-section {
		width: 100%;
		max-width: 45rem;
		margin-inline: auto;
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 3rem;
	}

	.not-found-section h1 {
		font-size: 7rem;
	}

	.not-found-section p {
		color: gray;
	}

	body {
		min-height: 100vh;
	}
</style>
