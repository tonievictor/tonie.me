---
import MainLayout from "../layout/main-layout.astro";
import { ProjectsData } from "../data/projects";
import Posts from "../components/Posts.astro";
---

<MainLayout
	title="Tonie Victor"
	description="Backend infrastructure, databases, distributed systems"
>
	<section class="home-section">
		<div class="about">
			<p>Hi, my name is Tonie Victor.</p>
			<p>
				This is a standing invitation: if you want to talk software, I
				want to talk to you. You can reach out to me via mail -
				hello@tonie.me - or by scheduling a call on my {" "}
				<a
					class="link"
					data-cal-link="tonievictor/coffee-chat"
					data-cal-namespace="coffee-chat"
					data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
				>
					calender.
				</a>
			</p>
		</div>
		<div>
			<h2>Recent Posts</h2>
			<Posts limit={3} />
		</div>
		<div>
			<h2>Projects</h2>
			<div class="projects-container">
				{
					ProjectsData.map((project) => (
						<a href={project.link} target="_blank" class="project">
							<h3>{project.title}</h3>
							<p>{project.overview}</p>
							<div class="tags">
								{project?.tags.map((tag) => (
									<span>#{tag}</span>
								))}
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</MainLayout>

<style>
	.home-section {
		width: 100%;
		max-width: 45rem;
		padding-top: 5rem;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.about {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.about .link {
		text-decoration: underline;
		cursor: pointer;
	}

	h2 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 24px;
		text-transform: uppercase;
		font-size: 14px;
		font-weight: normal;
	}

	h2::after {
		content: "";
		flex: 1;
		height: 1px;
		background: #e5e5e5;
	}

	.projects-container {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.project {
		text-decoration: none;
		color: black;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.project > h3 {
		font-size: 1.7rem;
		font-weight: 600;
	}

	.tags {
		display: flex;
		align-items: baseline;
		gap: 0.3rem;
		font-size: 14px;
		font-weight: 500;
		color: gray;
	}

	@media (max-width: 750px) {
		.home-section {
			padding: 3rem 1rem 0;
		}
	}
</style>

<script type="text/javascript">
	(function (C, A, L) {
		let p = function (a, ar) {
			a.q.push(ar);
		};
		let d = C.document;
		C.Cal =
			C.Cal ||
			function () {
				let cal = C.Cal;
				let ar = arguments;
				if (!cal.loaded) {
					cal.ns = {};
					cal.q = cal.q || [];
					d.head.appendChild(d.createElement("script")).src = A;
					cal.loaded = true;
				}
				if (ar[0] === L) {
					const api = function () {
						p(api, arguments);
					};
					const namespace = ar[1];
					api.q = api.q || [];
					if (typeof namespace === "string") {
						cal.ns[namespace] = cal.ns[namespace] || api;
						p(cal.ns[namespace], ar);
						p(cal, ["initNamespace", namespace]);
					} else p(cal, ar);
					return;
				}
				p(cal, ar);
			};
	})(window, "https://app.cal.com/embed/embed.js", "init");
	Cal("init", "coffee-chat", { origin: "https://app.cal.com" });
	Cal.config = Cal.config || {};
	Cal.config.forwardQueryParams = true;

	Cal.ns["coffee-chat"]("ui", {
		hideEventTypeDetails: false,
		layout: "month_view",
	});
</script>
