---
import "../../styles/global.css";
import Posts from "../../components/Posts.astro";
import MainLayout from "../../layout/main-layout.astro";
---

<MainLayout
	title="Blog"
	description="Backend infrastructure, databases, distributed systems"
>
	<section class="blog-section">
		<Posts />
	</section>
</MainLayout>

<style>
	.blog-section {
		width: 100%;
		max-width: 45rem;
		padding-top: 5rem;
		margin-inline: auto;
	}

	@media (max-width: 750px) {
		.blog-section {
			padding: 3rem 1rem 0;
		}
	}
</style>
