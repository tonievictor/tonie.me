---
import MainLayout from "../../../layout/main-layout.astro";
import { getCollection } from "astro:content";
import "../../../styles/blog.css";
import Posts from "../../../components/Posts.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	const tags = [...new Set(posts.map((p) => p.data.tags).flat())].filter(
		(p) => p.length > 0,
	);
	return tags.map((t) => ({
		params: { tag: t.replace(" ", "-") },
	}));
}

const { tag } = Astro.params;
---

<MainLayout
	title=`Blog | Tag: ${tag}`
	description="Backend infrastructure, databases, distributed systems"
>
	<section class="blog-section">
		<span>
			{`Showing results for tag: `}<b>{`${tag}`}</b>
		</span>
		<Posts tag={tag} />
	</section>
</MainLayout>

<style>
	.blog-section {
		width: 100%;
		max-width: 45rem;
		padding-top: 5rem;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.blog-section > span {
		font-style: italic;
		color: gray;
		font-weight: 500;
	}

	@media (max-width: 750px) {
		.blog-section {
			padding: 3rem 1rem 0;
		}
	}
</style>
